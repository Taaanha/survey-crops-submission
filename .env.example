# Copy this file to .env and fill in your actual values.
# .env is gitignored and never committed — this file (.env.example) is the
# only one that goes in the public repo.

HF_TOKEN=your_hugging_face_token_here
# Optional: which free Hugging Face model the /ask agent uses (default meta-llama/Llama-3.1-8B-Instruct)
# HF_MODEL=meta-llama/Llama-3.1-8B-Instruct
FIRMS_MAP_KEY=your_firms_map_key_here
EARTHDATA_TOKEN=your_nasa_earthdata_bearer_token_here